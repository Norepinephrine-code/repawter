# RePawter — environment configuration
#
# Copy to `.env` for local development or CI:
#
#     cp .env.example .env
#
# `.env` is git-ignored and is blocked from web access by the root .htaccess.
#
# Production should set these as real environment variables instead (Apache
# `SetEnv`, php-fpm `env[]`, or the systemd unit) — a real environment variable
# always overrides the same key in .env.
#
# Full reference, including which of these are required in production:
# docs/CONFIGURATION.md


# ── Application ──────────────────────────────────────────────────────────────

# Display name, used in the browser title and page furniture.
APP_NAME=RePawter

# `dev` or `prod`.
#   dev  — errors shown on screen, session cookies work over plain HTTP
#   prod — errors logged to storage/logs/php-error.log and never displayed,
#          session cookies marked Secure (HTTPS required)
# MUST be `prod` on a live server.
APP_ENV=dev

# URL path the app is served under, with a leading slash and no trailing slash.
#   /repawter   XAMPP default (htdocs/repawter)
#   (empty)     served at the domain root, e.g. https://repawter.example.gov.ph
BASE_URL=/repawter

# PHP timezone identifier. All timestamps are stored and displayed in this zone.
APP_TZ=Asia/Manila


# ── Database ─────────────────────────────────────────────────────────────────

DB_HOST=127.0.0.1
DB_NAME=repawter

# The runtime account needs only SELECT, INSERT, UPDATE, DELETE.
# Never use `root` in production.
DB_USER=root
DB_PASS=

DB_CHARSET=utf8mb4

# Optional: a separate, more privileged account used only by db/migrate.php,
# so the runtime user does not need DDL rights. Falls back to DB_USER/DB_PASS.
#DB_MIGRATION_USER=repawter_ddl
#DB_MIGRATION_PASS=


# ── Uploads ──────────────────────────────────────────────────────────────────

# Maximum accepted image size in bytes (default 5 MiB).
# PHP's own upload_max_filesize and post_max_size must be at least this large.
MAX_UPLOAD_BYTES=5242880


# ── Security ─────────────────────────────────────────────────────────────────

# Send session cookies only over HTTPS. Defaults to true when APP_ENV=prod.
# Set to false only for a staging box running prod config over plain HTTP —
# leaving it on without HTTPS means the session cookie is never stored and
# nobody can stay logged in.
#SESSION_SECURE=true

# Trust the X-Forwarded-Proto header when deciding whether the request is HTTPS.
# Enable ONLY when the app sits behind a reverse proxy or load balancer you
# control; the header is attacker-supplied otherwise.
TRUST_PROXY=false


# ── Test suite only ──────────────────────────────────────────────────────────
# Read by tests/, never by the application. See tests/README.md.

# Origin the Playwright suite drives. Must match where the app is served.
#E2E_BASE_URL=http://127.0.0.1:8100/repawter

# Database the E2E suite resets between runs. Point this at a throwaway
# database — the suite truncates it.
#E2E_DB_NAME=repawter_e2e
