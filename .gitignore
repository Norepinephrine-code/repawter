# ── Uploaded & generated media (keep folder structure, ignore contents) ──
/uploads/reports/*
/uploads/pets/*
/uploads/resources/*
/uploads/agreements/*
!/uploads/reports/.gitkeep
!/uploads/pets/.gitkeep

# ── OS / editor cruft ──
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.log
*.tmp

# ── Local IDE ──
.vscode/
.idea/

# ── Local config override (never commit real production credentials) ──
app/config/config.local.php

# ── Environment file (real secrets live here; .env.example is the template) ──
.env

# ── Storage / runtime logs (created at deploy time) ──
/storage/logs/*
!/storage/logs/.gitkeep
!/storage/.gitkeep

# ── Node / test tooling ──
/node_modules/
/test-results/
/playwright-report/
/coverage/
